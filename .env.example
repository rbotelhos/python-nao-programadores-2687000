# =============================================
# Configurações do Robô de Monitoramento Anatel
# =============================================
# Copie este arquivo para .env e preencha os valores

# ----- Banco de Dados -----
# Caminho do arquivo SQLite (padrão: ./anatel_consultas.db)
DB_PATH=anatel_consultas.db

# ----- Agendamento -----
# Horário diário de execução (formato HH:MM)
HORARIO_EXECUCAO=08:00

# ----- Playwright -----
# true = executa o browser sem abrir janela (recomendado em servidores)
PLAYWRIGHT_HEADLESS=true
# Timeout em milissegundos por operação de página
PLAYWRIGHT_TIMEOUT_MS=30000

# ----- Notificações por E-mail (opcional) -----
# Defina EMAIL_ENABLED=true para ativar o envio
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app
# Lista separada por vírgula
EMAIL_DESTINATARIOS=destinatario1@exemplo.com,destinatario2@exemplo.com
